# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=motorpoint_db
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=America/Lima

# ==========================================
# CONFIGURACIÓN JPA/HIBERNATE
# ==========================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ==========================================
# CONFIGURACIÓN DE PERFIL SPRING
# ==========================================
# Valores: local, dev, prod
SPRING_PROFILE=local

# ==========================================
# CONFIGURACIÓN JWT (JSON Web Token)
# ==========================================
# Clave secreta para firmar tokens (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=mySecretKeyForMotorPointBackend2024
# Tiempo de expiración en milisegundos (24 horas = 86400000)
JWT_EXPIRATION=86400000

# ==========================================
# CONFIGURACIÓN CORS (Cross-Origin Resource Sharing)
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ==========================================
# CONFIGURACIÓN DE LOGGING
# ==========================================
# LOG_LEVEL puede ser: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG
